Description: Build without closed APFS headers and FSKit
 Include the APFS headers only where the code uses them. Correct the
 sysctl length argument. Return ENOTSUP when FSKit is unavailable.
Author: The Blueberry Pie OS Authors
Forwarded: not-needed
Last-Update: 2026-11-04

--- /dev/null
+++ b/disklib/fskit_none.c
@@ -0,0 +1,18 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ * Copyright (c) 2026 The Blueberry Pie OS Authors
+ */
+
+#include <errno.h>
+
+#include "fskit_support.h"
+
+int
+invoke_tool_from_fskit(fskit_command_t operation, int flags, int argc, char * const *argv)
+{
+	(void)operation;
+	(void)flags;
+	(void)argc;
+	(void)argv;
+	return ENOTSUP;
+}
